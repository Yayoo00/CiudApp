@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-ciudapp">
    
    <h1>Tu ciudad,<br><span>tu voz</span>, tu impacto.</h1>
    <p>CiudApp conecta a jóvenes con su entorno: retos ecológicos, rutas seguras, vida universitaria y más.</p>

<div class="hero-buttons">

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a class="btn-main"
           asp-controller="Dashboard"
           asp-action="Index">
            Ir a mi Dashboard
        </a>
    }
    else
    {
        <a class="btn-main"
           asp-area="Identity"
           asp-page="/Account/Login">
            Comenzar ahora
        </a>
    }

    <a class="btn-secondary">
        Ver el mapa
    </a>

</div>

    <div class="hero-stats">
        <div><strong>24,500+</strong><small>Jóvenes activos</small></div>
        <div><strong>180K+</strong><small>Retos completados</small></div>
        <div><strong>12</strong><small>Ciudades</small></div>
        <div><strong>+78%</strong><small>Impacto</small></div>
    </div>
</section>

<section id="modulos" class="section-title">
    <h2>Explora CiudApp</h2>
    <p>Selecciona un módulo para comenzar</p>
</section>

<section class="cards-grid">
    <div class="module-card green">
        <div class="card-img"></div>
        <div class="card-body">
            <h3>EcoRetos</h3>
            <p>Cumple desafíos ecológicos y gana puntos</p>
            <small>2,450 retos completados hoy →</small>
        </div>
    </div>

    <div class="module-card orange">
        <div class="card-img"></div>
        <div class="card-body">
            <h3>CiudadMap</h3>
            <p>Reporta y visualiza problemas en tu ciudad</p>
            <small>328 reportes activos →</small>
        </div>
    </div>

    <div class="module-card blue" onclick="location.href='@Url.Action("Index","Rutas")'">
        <div class="card-img"></div>
        <div class="card-body">
            <h3>Rutas Seguras</h3>
            <p>Encuentra rutas ciclistas seguras en tu ciudad</p>
            <small>42 rutas disponibles →</small>
        </div>
    </div>

    <div class="module-card purple">
        <div class="card-img"></div>
        <div class="card-body">
            <h3>Vida Universitaria</h3>
            <p>Tips, recordatorios, comida y lugares cerca de tu U</p>
            <small>1,200 estudiantes activos →</small>
        </div>
    </div>

    <div class="module-card pink">
        <div class="card-img"></div>
        <div class="card-body">
            <h3>Eventos</h3>
            <p>Conciertos, hackathons, ferias y eventos culturales</p>
            <small>18 eventos esta semana →</small>
        </div>
    </div>

    <div class="module-card teal">
        <div class="card-img"></div>
        <div class="card-body">
            <h3>Prácticas</h3>
            <p>Encuentra pasantías y oportunidades profesionales</p>
            <small>89 vacantes abiertas →</small>
        </div>
    </div>
</section>

<section class="ranking-box">
    <h2>🏆 Top Eco-Héroes</h2>

    <div class="rank-item">
        <span>#1 🏆 Sofía R.</span>
        <div class="bar"><div style="width:95%"></div></div>
        <strong>4,820</strong>
    </div>

    <div class="rank-item">
        <span>#2 ♻️ Carlos M.</span>
        <div class="bar"><div style="width:85%"></div></div>
        <strong>4,310</strong>
    </div>

    <div class="rank-item">
        <span>#3 🚴 Valentina P.</span>
        <div class="bar"><div style="width:78%"></div></div>
        <strong>3,990</strong>
    </div>

    <div class="rank-item">
        <span>#4 🌳 Juan D.</span>
        <div class="bar"><div style="width:70%"></div></div>
        <strong>3,750</strong>
    </div>
</section>

