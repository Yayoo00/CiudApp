@{
    ViewData["Title"] = "Contacto";
}

<section class="section-title">
    <h2>Contáctanos</h2>
    <p>Comunícate con el equipo de CiudApp</p>
</section>

<section class="quick-box">
    <form>
        <input class="form-control mb-3" placeholder="Nombre completo" />
        <input class="form-control mb-3" placeholder="Correo electrónico" />
        <textarea class="form-control mb-3" rows="5" placeholder="Escribe tu mensaje"></textarea>
        <button class="btn-main border-0">Enviar mensaje</button>
    </form>
</section>