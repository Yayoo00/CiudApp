@model List<CiudApp.Models.Recompensa>

@{
    ViewData["Title"] = "Catálogo de Recompensas";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="container mt-5">

    <h1 class="text-center text-white mb-4">
        🎁 Catálogo de Recompensas
    </h1>

    <div class="row">

        @foreach (var recompensa in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow h-100">

                    <div class="card-body text-dark">

                        <h4 class="text-dark">@recompensa.Nombre</h4>

                        <p class="text-dark">@recompensa.Descripcion</p>

                        <h5 class="text-dark">
                            ⭐ @recompensa.CostoPuntos puntos
                        </h5>

                        <form asp-action="Canjear" method="post">

                        <input type="hidden"
                            name="id"
                            value="@recompensa.Id" />

                        <button type="submit"
                            class="btn btn-primary">
                        Canjear
                        </button>

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>

</div>