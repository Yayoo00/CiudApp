@model List<CiudApp.Models.Recompensa>

@{
    ViewData["Title"] = "Catálogo de Recompensas";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="text-center mb-4">
    <div class="user-points">
        ⭐ Tus puntos: @ViewBag.Puntos
    </div>
</div>

<div class="container mt-5">

    <h1 class="text-center text-white mb-4">
        🎁 Catálogo de Recompensas
    </h1>

    <div class="row">

        @foreach (var recompensa in Model)
{
    <div class="col-lg-4 col-md-6 mb-4">

        <div class="reward-card">

            <div class="reward-icon">
                @recompensa.Nombre.Split(' ')[0]
            </div>

            <h3>@recompensa.Nombre</h3>

            <p class="reward-description">
                @recompensa.Descripcion
            </p>

            <div class="reward-points">
                ⭐ @recompensa.CostoPuntos puntos
            </div>

            @if (ViewBag.Puntos >= recompensa.CostoPuntos)
{
    <form asp-action="Canjear" method="post">

        <input type="hidden"
            name="id"
            value="@recompensa.Id" />

        <button type="submit"
            class="btn-canjear">
            🎁 Canjear
        </button>

    </form>
}
else
{
    <button class="btn-no-disponible" disabled>
        🔒 No disponible
    </button>
}

        </div>

    </div>
}

    </div>

</div>