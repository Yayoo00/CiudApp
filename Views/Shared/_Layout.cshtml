@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CiudApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CiudApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">🚀 CiudApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
<ul class="navbar-nav flex-grow-1">
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
    </li>

    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Catalogo" asp-action="Index">Catálogo</a>
    </li>

    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Contacto" asp-action="Index">Contacto</a>
    </li>

    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
    </li>


    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link text-danger fw-bold"
               asp-controller="Admin"
               asp-action="Index">
                🔒 Panel Admin
            </a>
        </li>
    }
</ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
   <div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

<button id="chatButton" class="chat-float">
    🤖
</button>

<div id="chatBox">

    <div class="chat-header">
        🤖 Asistente IA
    </div>

<div class="chat-body">

    <div id="respuesta"></div>

    <textarea id="pregunta"
              rows="3"
              placeholder="Pregunta algo sobre CiudApp...">
    </textarea>

    <button id="btnPreguntar">
        Consultar
    </button>

</div>

</div>

<script>
document.getElementById("chatButton")
.addEventListener("click", function () {

    const box = document.getElementById("chatBox");

    if (box.style.display === "block")
        box.style.display = "none";
    else
        box.style.display = "block";
});

document.getElementById("btnPreguntar")
.addEventListener("click", async function () {

    const pregunta = document.getElementById("pregunta").value;

    if (!pregunta.trim())
        return;

    document.getElementById("pregunta").value = "";

    const chat = document.getElementById("respuesta");

    chat.innerHTML += `
    <div style="margin-bottom:10px;">
        <strong>🧑 Tú:</strong><br>
        ${pregunta}
    </div>
    `;

    chat.innerHTML += `
    <div id="loading" style="
        background:#334155;
        padding:10px;
        border-radius:10px;
        margin-bottom:15px;">
        ⏳ Consultando IA...
    </div>
    `;

    chat.scrollTop = chat.scrollHeight;

    const response = await fetch(
        "/api/asistente/preguntar",
        {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                pregunta: pregunta
            })
        });

    const data = await response.json();

    document.getElementById("loading").remove();

    chat.innerHTML += `
    <div style="
        background:#334155;
        padding:10px;
        border-radius:10px;
        margin-bottom:15px;">
        <strong>🤖 IA:</strong><br>
        ${data.respuesta}
    </div>
    `;

    chat.scrollTop = chat.scrollHeight;
});

document.getElementById("pregunta")
.addEventListener("keydown", function(e){

    if(e.key === "Enter" && !e.shiftKey)
    {
        e.preventDefault();
        document.getElementById("btnPreguntar").click();
    }

});
</script>


</body>
</html>
