@model List<CiudApp.Models.Recompensa>

@{
    ViewData["Title"] = "Panel Admin";
}

<h1>🔒 Panel Administrador</h1>

<div class="row mb-4">

    <div class="col-md-4">
        <div class="admin-stat">
            🎁 Recompensas
            <h3>@Model.Count</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="admin-stat">
            ⭐ Promedio
            <h3>@Math.Round(Model.Average(x => x.CostoPuntos))</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="admin-stat">
            👑 Rol
            <h3>Administrador</h3>
        </div>
    </div>

</div>

<div class="admin-form mb-4">
    <h4>➕ Nueva recompensa</h4>

    <form asp-action="Crear" method="post">

        <div class="mb-2">
            <input class="form-control"
                   name="nombre"
                   placeholder="Nombre" />
        </div>

        <div class="mb-2">
            <input class="form-control"
                   name="descripcion"
                   placeholder="Descripción" />
        </div>

        <div class="mb-2">
            <input class="form-control"
                   name="costoPuntos"
                   type="number"
                   placeholder="Costo en puntos" />
        </div>

        <button class="btn btn-success">
            Agregar recompensa
        </button>

    </form>
</div>

<div class="row">

@foreach(var item in Model)
{
    <div class="col-lg-4 col-md-6 mb-4">

        <div class="admin-card">
            <div class="admin-icon">
                @item.Nombre.Split(' ')[0]
            </div>
            <h3>@item.Nombre</h3>

            <p>@item.Descripcion</p>

            <div class="admin-points">
                ⭐ @item.CostoPuntos puntos
            </div>

            <div class="mt-3">

                <a asp-action="Editar"
                   asp-route-id="@item.Id"
                   class="btn btn-warning btn-sm">
                    ✏️ Editar
                </a>

                <form asp-action="Eliminar"
                      method="post"
                      style="display:inline;">

                    <input type="hidden"
                           name="id"
                           value="@item.Id" />

                    <button class="btn btn-danger btn-sm">
                        🗑 Eliminar
                    </button>

                </form>

            </div>

        </div>

    </div>
}

</div>

<hr class="my-5" />

<h2>📨 Sugerencias Recibidas</h2>

@if (ViewBag.Sugerencias != null)
{
    @foreach (var sugerencia in ViewBag.Sugerencias)
    {
        <div class="admin-card mb-3">

            <h5>👤 @sugerencia.Nombre</h5>

            <p><strong>📧 Correo:</strong> @sugerencia.Correo</p>

            <p><strong>📌 Asunto:</strong> @sugerencia.Asunto</p>

            <p><strong>💬 Comentario:</strong></p>

            <div class="comentario-box">
                @sugerencia.Comentario
            </div>

            <small class="text-muted">
                @sugerencia.Fecha.ToString("dd/MM/yyyy HH:mm")
            </small>

        </div>
    }
}