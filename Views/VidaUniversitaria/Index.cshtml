@{
    ViewData["Title"] = "Vida Universitaria";
}

<section class="section-title">
    <h2>🎓 Vida Universitaria</h2>
    <p>Consejos y recursos para estudiantes.</p>
</section>

<div class="row">

    <div class="col-md-4 mb-4">
        <div class="reward-card">
            <h3>📚 Biblioteca</h3>
            <p>Horario: 8:00 AM - 10:00 PM</p>
            <small>Biblioteca Central USMP</small>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="reward-card">
            <h3>🍔 Comedores</h3>
            <p>Menú desde S/ 8.00</p>
            <small>Pabellón Central</small>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="reward-card">
            <h3>📝 Tips de estudio</h3>
            <p>Técnica Pomodoro</p>
            <small>25 min estudio + 5 min descanso</small>
        </div>
    </div>

</div>

<div class="row mt-4">

    <div class="col-md-6 mb-4">
        <div class="reward-card">
            <h3>📅 Próximas actividades</h3>

            <ul class="text-start mt-3">
                <li>📖 Examen Parcial - 25/06/2026</li>
                <li>💻 Feria Tecnológica - 28/06/2026</li>
                <li>🚀 Hackathon USMP - 05/07/2026</li>
                <li>🎓 Charla de Empleabilidad - 10/07/2026</li>
            </ul>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="reward-card">
            <h3>🎯 Consejo del día</h3>

            <p class="mt-3">
                Organiza tus tareas por prioridad y utiliza
                la técnica Pomodoro para mejorar tu concentración.
            </p>

            <p>
                Mantén descansos cortos para evitar la fatiga mental.
            </p>
        </div>
    </div>

</div>